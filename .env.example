# This model is already installed locally.
# Ollama 若只绑定回环地址，用 localhost；
# 若已开放局域网访问（OLLAMA_HOST=0.0.0.0），改填局域网地址，例如：
#   OLLAMA_BASE_URL=http://192.168.31.180:11434
# 判断方法：curl <地址>/api/tags 能返回模型列表即为可用。
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_BASE_URL=http://localhost:11434

# Article agent sources. Use comma-separated HTTP(S) endpoints.
ARTICLE_SEARCH_URLS=
ARTICLE_DOWNLOAD_URLS=
ARTICLE_DOWNLOAD_DIR=./data/articles

# ---------- 线上模型 provider（spec-035）----------
# 线上模型清单：逗号分隔的 provider:model（缺 Key 或地址非法的条目不会被注册）
ONLINE_MODELS=
# Research Runtime 仅在显式开启后才会把瞬态失败切换到已注册线上模型。
RESEARCH_ONLINE_FALLBACK_ENABLED=false
# 每个 provider 一组（provider 名转大写 + 下划线）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Semantic Scholar Academic Graph API（可选；留空时使用公共限流）
SEMANTIC_SCHOLAR_API_KEY=
# 已有官方/DBLP 候选不足时允许受控批量补充；候选仍标为聚合来源并经评估
SEMANTIC_SCHOLAR_BULK_RECALL_ENABLED=false
SEMANTIC_SCHOLAR_BULK_RECALL_MIN_RESULTS=5
# 仅为缺少摘要/作者/DOI/ArXiv 的候选补齐元数据
SEMANTIC_SCHOLAR_METADATA_ENRICHMENT_ENABLED=false

# ---------- 线上 embedding（OpenAI 兼容 /v1/embeddings，如阿里云 DataWorks）----------
# 留空 EMBED_PROVIDER 则走默认 Ollama bge-m3；设为 online 改用线上服务，不再依赖本机 Ollama。
# EMBED_PROVIDER=online
# EMBED_MODEL=bge-m3
# EMBED_BASE_URL=http://ms-xxx.cn-beijing.dataworks-model.aliyuncs.com/v1
# EMBED_API_KEY=DW-ms-xxx          # 原样作为 Authorization 头（无 Bearer 前缀）
# EMBED_DIM=1024                   # bge-m3 维度，与现有 KB 索引一致则无需重建
