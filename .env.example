# This model is already installed locally.
# Ollama 若只绑定回环地址，用 localhost；
# 若已开放局域网访问（OLLAMA_HOST=0.0.0.0），改填局域网地址，例如：
#   OLLAMA_BASE_URL=http://192.168.31.180:11434
# 判断方法：curl <地址>/api/tags 能返回模型列表即为可用。
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_BASE_URL=http://localhost:11434

# Article agent sources. Use comma-separated HTTP(S) endpoints.
ARTICLE_SEARCH_URLS=
ARTICLE_DOWNLOAD_URLS=
ARTICLE_DOWNLOAD_DIR=./data/articles