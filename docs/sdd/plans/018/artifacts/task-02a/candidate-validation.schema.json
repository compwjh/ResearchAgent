{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec-018/candidate-validation-v1",
  "title": "Spec018 CandidateValidationV1",
  "description": "Run-level candidate validation artifact. A ``bootstrap`` run publishes an empty generation for a cold-start library and therefore carries no documents, points or query probes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "candidate_collection", "topology_digest", "status", "documents", "collection_totals", "config_fingerprints", "query_probes", "collection_fingerprint", "validated_at", "errors"],
  "$defs": {
    "dense": {"type": "object", "additionalProperties": false, "required": ["name", "dimension", "all_finite", "vector_digest"], "properties": {"name": {"const": "dense"}, "dimension": {"type": "integer", "minimum": 1}, "all_finite": {"type": "boolean"}, "vector_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "sparse": {"type": "object", "additionalProperties": false, "required": ["name", "point_count", "all_indices_sorted", "all_values_finite", "total_nnz", "vector_digest"], "properties": {"name": {"const": "sparse"}, "point_count": {"type": "integer", "minimum": 0}, "all_indices_sorted": {"type": "boolean"}, "all_values_finite": {"type": "boolean"}, "total_nnz": {"type": "integer", "minimum": 0}, "vector_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "version": {"type": "object", "additionalProperties": false, "required": ["chunk_count", "point_ids", "chunk_indexes", "payload_schema_version", "chunker_config_fingerprint", "embedding_config_fingerprint", "model_config_fingerprint", "llm_used", "anchor_count", "unmapped_count", "dense", "sparse", "payload_digest", "text_digest", "anchor_digest"], "properties": {"chunk_count": {"type": "integer", "minimum": 1}, "point_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "chunk_indexes": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "payload_schema_version": {"type": "string", "minLength": 1}, "chunker_config_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "embedding_config_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "model_config_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "llm_used": {"type": "boolean"}, "anchor_count": {"type": "integer", "minimum": 0}, "unmapped_count": {"type": "integer", "minimum": 0}, "dense": {"$ref": "#/$defs/dense"}, "sparse": {"$ref": "#/$defs/sparse"}, "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "text_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "anchor_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "document": {"type": "object", "additionalProperties": false, "required": ["document_id", "media_type", "source_sha256", "indexed_source_sha256", "parser_version", "v1", "v2"], "properties": {"document_id": {"type": "string", "minLength": 1}, "media_type": {"enum": ["application/pdf", "text/markdown"]}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "indexed_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "parser_version": {"type": "string", "minLength": 1}, "v1": {"$ref": "#/$defs/version"}, "v2": {"$ref": "#/$defs/version"}}},
    "probe": {"type": "object", "additionalProperties": false, "required": ["query_digest", "top_document_ids", "candidate_hit"], "properties": {"query_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "top_document_ids": {"type": "array", "items": {"type": "string"}}, "candidate_hit": {"type": "boolean"}}}
  },
  "properties": {
    "schema_version": {"const": "candidate-validation-v1"}, "run_id": {"type": "string", "minLength": 1}, "candidate_collection": {"type": "string", "minLength": 1}, "topology_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "status": {"enum": ["passed", "failed"]}, "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}}, "collection_totals": {"type": "object", "additionalProperties": false, "required": ["document_count", "point_count", "v1_point_count", "v2_point_count"], "properties": {"document_count": {"type": "integer", "minimum": 0}, "point_count": {"type": "integer", "minimum": 0}, "v1_point_count": {"type": "integer", "minimum": 0}, "v2_point_count": {"type": "integer", "minimum": 0}}}, "config_fingerprints": {"type": "object", "additionalProperties": false, "required": ["embedding", "v1_chunker", "v2_chunker", "model"], "properties": {"embedding": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "v1_chunker": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "v2_chunker": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "model": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "query_probes": {"type": "object", "additionalProperties": false, "properties": {"dense": {"$ref": "#/$defs/probe"}, "sparse": {"$ref": "#/$defs/probe"}}}, "collection_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "validated_at": {"type": "string", "minLength": 1}, "errors": {"type": "array", "items": {"type": "string"}}, "bootstrap": {"type": "boolean"}
  },
  "if": {"properties": {"bootstrap": {"const": true}}, "required": ["bootstrap"]},
  "then": {
    "properties": {
      "documents": {"maxItems": 0},
      "query_probes": {"maxProperties": 0},
      "collection_totals": {"properties": {"document_count": {"const": 0}, "point_count": {"const": 0}, "v1_point_count": {"const": 0}, "v2_point_count": {"const": 0}}}
    }
  },
  "else": {
    "properties": {
      "documents": {"minItems": 1},
      "query_probes": {"required": ["dense", "sparse"]},
      "collection_totals": {"properties": {"document_count": {"minimum": 1}, "point_count": {"minimum": 2}, "v1_point_count": {"minimum": 1}, "v2_point_count": {"minimum": 1}}}
    }
  }
}
