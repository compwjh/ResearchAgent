{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec-018/candidate-rebuild-run-v1",
  "title": "Spec018 candidate rebuild run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source_collection", "candidate_collection", "chunkers", "status", "progress", "dry_run", "document_counts", "point_counts", "new_fingerprint", "error_code", "intent", "observed", "previous_target", "initial_topology_digest", "validated_topology_digest"],
  "$defs": {
    "intent": {"type": "object", "additionalProperties": false, "required": ["sequence", "action", "candidate", "previous_target", "expected_topology_digest", "started_at"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "action": {"type": "string", "minLength": 1}, "candidate": {"type": "string", "minLength": 1}, "previous_target": {"type": ["string", "null"]}, "expected_topology_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "started_at": {"type": "string", "minLength": 1}}},
    "observed": {"type": "object", "additionalProperties": false, "required": ["sequence", "action", "phase", "outcome", "previous_target", "expected_topology_digest", "fresh_topology", "topology_digest", "completed_at"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "action": {"type": "string", "minLength": 1}, "phase": {"const": "after"}, "outcome": {"enum": ["ok", "error", "unknown"]}, "previous_target": {"type": ["string", "null"]}, "expected_topology_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "fresh_topology": {"type": ["object", "null"], "additionalProperties": false, "required": ["schema_version", "inventory_digest"], "properties": {"schema_version": {"const": "topology-inventory-v1"}, "inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "topology_digest": {"type": ["string", "null"]}, "error_code": {"type": "string"}, "completed_at": {"type": "string", "minLength": 1}}}
  },
  "properties": {
    "schema_version": {"const": "candidate-rebuild-run-v1"}, "run_id": {"type": "string", "minLength": 1}, "source_collection": {"type": ["string", "null"]}, "candidate_collection": {"type": "string", "minLength": 1}, "chunkers": {"type": "array", "prefixItems": [{"const": "v1"}, {"const": "v2"}], "minItems": 2, "maxItems": 2}, "status": {"enum": ["preflight", "building", "validating", "ready_to_switch", "switching", "finalize_pending", "finalizing", "cleanup_pending", "cleaned", "completed", "failed"]}, "progress": {"type": "integer", "minimum": 0, "maximum": 100}, "dry_run": {"type": "boolean"}, "document_counts": {"type": "object", "additionalProperties": false, "required": ["authoritative", "orphan"], "properties": {"authoritative": {"type": "integer", "minimum": 0}, "orphan": {"type": "integer", "minimum": 0}}}, "point_counts": {"type": "object", "additionalProperties": false, "required": ["v1", "v2", "total"], "properties": {"v1": {"type": "integer", "minimum": 0}, "v2": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}}, "new_fingerprint": {"type": "object", "additionalProperties": false, "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "point_count": {"type": "integer", "minimum": 0}, "validation_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "topology_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "minProperties": 0, "maxProperties": 4}, "error_code": {"type": ["string", "null"]}, "intent": {"anyOf": [{"$ref": "#/$defs/intent"}, {"type": "null"}]}, "observed": {"anyOf": [{"$ref": "#/$defs/observed"}, {"type": "null"}]}, "previous_target": {"type": ["string", "null"]}, "initial_topology_digest": {"type": ["string", "null"], "pattern": "^([0-9a-f]{64})?$"}, "validated_topology_digest": {"type": ["string", "null"], "pattern": "^([0-9a-f]{64})?$"}
  }
}
