0-122f-43b5-9b74-18ab43a169e8","created_at":"2026-10-30T15:57:07Z","fingerprint":"f4953bf2adcac46c549b9d327f627bc0246a99f9e0021bfd64b1b257658d7c06","granted_model_loops":40,"granted_seconds":300,"granted_tool_calls":160,"requested_model_loops":40,"requested_seconds":300,"requested_tool_calls":160,"run_model_loops_limit":40,"run_tool_calls_limit":160,"settled":true,"work_item_id":"387a5090b27550c59de86adb415eb26e:syn"},{"agent_run_id":"387a5090b27550c59de86adb415eb26e:syn:report-1:drafting-009a0456156544d0bc9f13ea1c989c77","claim_id":"8d585289-1210-4763-b1a1-5c002e6d785e","created_at":"2026-10-30T15:58:58Z","fingerprint":"e774b43d76d03f7f75b389dd0202d6f5f830b154ec403c85260e16f1bf60c5cf","granted_model_loops":40,"granted_seconds":300,"granted_tool_calls":160,"requested_model_loops":40,"requested_seconds":300,"requested_tool_calls":160,"run_model_loops_limit":40,"run_tool_calls_limit":160,"settled":true,"work_item_id":"387a5090b27550c59de86adb415eb26e:syn"}],"limits":{"max_seconds":1500,"model_loops":160,"run_model_loops":40,"run_tool_calls":160,"tool_calls":640},"revision":12,"rewrite_count":0,"stage":"published"},"work_item_id":"387a5090b27550c59de86adb415eb26e:syn"},"plan_version":1,"published":true,"quality_validation":{"cjk_count":2920,"comparison_count":3,"count_method":"report-quality-v1","failure_codes":[],"invalid_evidence_count":0,"paper_count":5,"revision_count":0,"schema_version":"report-quality-v1","status":"pass","supported_finding_count":5},"reason_codes":[],"report_content":{"cross_paper_comparisons":[{"dimension_id":"facet-1","evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797","evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"paper_ids":["bf973b6a0943cb3d3165ec26e72e6915","240837c172070c94fb76db82dc400a9c","c74f345888764f1ac8def289ebee0ec4","29e0052a154dc45edd232d6dfa40c76c","932b9f2a403b4a1433151236be9173f7"],"statement":"方法比较（跨域类比）：五篇摘要呈现五种不同的证据生产路径。ML论文做30篇顶会论文的文献审计并辅以实证分析；WCD论文设计检测方法，并在404个站点做比较实验、在Alexa Top 10K做大规模测量和案例研究；LGBTQ+论文做14人半结构化质性访谈；内核论文先访谈专家，再在17个真实内核堆漏洞利用上评估稳定化技术并构建利用模型；RPKI论文构造降级攻击并实验测量公共仓库与依赖方实现。它们分别服务于机器学习评估、Web缓存、人因、内核利用和路由安全等不同问题，因此只能作为认证安全研究方法讨论的跨域类比，不能据此推断USENIX Security 2022认证论文的方法分布。"},{"dimension_id":"facet-2","evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797","evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"paper_ids":["bf973b6a0943cb3d3165ec26e72e6915","240837c172070c94fb76db82dc400a9c","c74f345888764f1ac8def289ebee0ec4","29e0052a154dc45edd232d6dfa40c76c","932b9f2a403b4a1433151236be9173f7"],"statement":"安全问题比较：所选摘要的安全问题分别落在 Web 缓存泄露、RPKI 路由验证降级、Linux 内核堆利用可靠性、机器学习安全评估缺陷、LGBTQ+ 数字安全建议获取。WCD摘要明确提到认证门后内容泄露背景，但其研究焦点是 WCD 检测与影响，因此只标为相邻；ML、LGBTQ+、内核与RPKI分别处于评估方法、人因、内核利用与路由安全层，均只能作为跨域类比。RPKI的 validation 与WCD的认证门后背景都不能被当作对用户登录认证机制本身的研究，按关键词归并会混淆保护对象与系统层。"},{"dimension_id":"facet-3","evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797","evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"paper_ids":["bf973b6a0943cb3d3165ec26e72e6915","240837c172070c94fb76db82dc400a9c","c74f345888764f1ac8def289ebee0ec4","29e0052a154dc45edd232d6dfa40c76c","932b9f2a403b4a1433151236be9173f7"],"statement":"发现与证据边界比较：WCD摘要报告404站点比较中100+漏洞、Alexa Top 10K中1188个易受攻击网站；RPKI摘要报告至少47%公共仓库和20.4% IPv4地址空间；内核摘要报告平均14.87%与组合135.53%提升；ML摘要审计30篇论文；LGBTQ+摘要访谈14人。它们均是摘要级结果；摘要未展开观察窗口、样本代表性或生产部署运行细节，不能把摘要结果升级为全文结论或部署结论。不同数字分别描述测量、实验或审计对象，不能当作认证安全效果的排序。"}],"evidence_scope":{"paper_ids":["bf973b6a0943cb3d3165ec26e72e6915","240837c172070c94fb76db82dc400a9c","c74f345888764f1ac8def289ebee0ec4","29e0052a154dc45edd232d6dfa40c76c","932b9f2a403b4a1433151236be9173f7"],"text":"本报告仅依据5篇论文的摘要级片段（abstract），没有使用全文、代码、附录或作者补充材料。所给摘要没有统一的会议/年份元数据，因此不能确认这5篇论文都属于 USENIX Security 2022 的认证安全专题；下文的“认证安全”只能是研究问题中的检索语境，不能当作已核实的论文分类。所有方法、发现与数字均保持在摘要陈述的范围；摘要未展开的观察窗口、样本代表性、部署运行细节等，只能标为证据边界或推断性缺口，不能反推相关活动不存在。五篇论文分别涉及机器学习安全评估、Web 缓存欺骗、LGBTQ+ 安全建议、Linux 内核堆利用可靠性与 RPKI 降级攻击；它们与用户认证机制的关系需要逐篇按研究范围判断，不能按关键词重叠归类。"},"paper_analyses":[{"findings":{"evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797"],"status":"supported","text":"Relation: cross-domain。该研究没有用户认证或认证凭据对象；其评估与保护对象是学习型安全系统在安全任务中的性能与评估有效性，系统层面为方法论与评估层。摘要报告这些陷阱在当前安全文献中广泛存在，单个陷阱可导致不现实性能并阻碍对安全问题的理解；作者给出避免或缓解陷阱的建议，并指出机器学习用于安全的开放问题。由于研究对象是ML安全系统而非认证机制，只能作为认证安全研究方法讨论的跨域类比。"},"limitations":{"evidence_ids":[],"status":"not_stated","text":""},"method":{"evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797"],"status":"supported","text":"摘要报告的方法为：对过去10年30篇顶会安全论文进行文献审计，识别学习型安全系统在设计、实现与评估中的常见陷阱，并辅以实证分析展示单个陷阱如何导致不现实性能与解释；随后提出可操作建议并列出开放问题。该方法是方法论审计与实证演示的组合，不是用户认证实验。"},"paper_id":"bf973b6a0943cb3d3165ec26e72e6915"},{"findings":{"evidence_ids":["evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c"],"status":"supported","text":"Relation: adjacent。该研究相邻于认证安全，因为摘要明确说以往 WCD 文献只关注认证门后网站的个人信息泄露，且攻击可 targeting non-authenticated pages；受保护对象是认证门后或非认证页面的敏感内容，系统层面为 Web 缓存/HTTP 层。但研究焦点是 WCD 检测与影响，不是认证机制、凭据或会话管理本身。新方法在404个站点比较中识别100+漏洞，而先前方法上限为18；在 Alexa Top 10K 中检测到1188个易受攻击网站；案例表明 WCD 后果超出个人信息泄露，针对非认证页面的攻击也高度有害。"},"limitations":{"evidence_ids":[],"status":"not_stated","text":""},"method":{"evidence_ids":["evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c"],"status":"supported","text":"摘要报告提出一种新的 Web Cache Deception 检测方法，放弃以往方法的测试前提，使用页面同一性检查与缓存头启发式来测试网站；方法评估包括404个站点的比较实验、Alexa Top 10K 上的大规模测量以及案例研究。"},"paper_id":"240837c172070c94fb76db82dc400a9c"},{"findings":{"evidence_ids":["evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56"],"status":"supported","text":"Relation: cross-domain。该研究没有技术性认证机制或受保护对象；研究对象是 LGBTQ+ 人群的数字安全、隐私与建议获取，系统层面为人因/社会技术层。摘要报告参与者倾向向可信 queer 支持群体寻求建议，因为这些群体常经历相似威胁；参与者也因建议可能干扰生计或连接他人的机会而拒绝建议。作者建议 queer-specific 与一般安全建议都强调具体性（why/how）而非一致性，并讨论交叉性框架对理解安全研究中伤害脆弱性的价值。"},"limitations":{"evidence_ids":[],"status":"not_stated","text":""},"method":{"evidence_ids":["evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56"],"status":"supported","text":"摘要报告采用质性半结构化访谈，访谈14名 queer 参与者，参与者在种族、年龄、性别、性取向和社会经济地位上具有多样性；研究聚焦 queer 安全、安全与隐私建议获取，并据此提出对更广泛建议研究的启示。"},"paper_id":"c74f345888764f1ac8def289ebee0ec4"},{"findings":{"evidence_ids":["evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336"],"status":"supported","text":"Relation: cross-domain。该研究没有用户认证对象；摘要未具体声明受保护对象，研究对象是 Linux 内核堆布局与漏洞利用可靠性，系统层面为内核内存/漏洞利用层。摘要报告许多内核安全专家对利用稳定化技术的看法不正确；新技术平均提升 Linux 内核利用可靠性14.87%；将该技术与现有稳定化方法组合后，平均提升135.53%，比专业安全研究人员的利用稳定化高67.86%。这些是摘要级实验与评估结果，不是认证安全结论。"},"limitations":{"evidence_ids":[],"status":"not_stated","text":""},"method":{"evidence_ids":["evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336"],"status":"supported","text":"摘要报告先访谈内核安全专家，收集常用的利用稳定化技术与专家意见；随后在17个真实世界内核堆漏洞利用上评估这些稳定化技术，检查实验结果并设计通用内核堆利用模型，再用模型解释利用不可靠性、分析稳定化技术成败，并提出一种新的利用技术。"},"paper_id":"29e0052a154dc45edd232d6dfa40c76c"},{"findings":{"evidence_ids":["evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"status":"supported","text":"Relation: cross-domain。该研究不是用户认证；它涉及 RPKI 路由验证，受保护对象是 RPKI 保护的前缀/路由信息，系统层面为互联网路由与 PKI 基础设施层。摘要报告至少47%的公共仓库对一种特定限速离线降级攻击脆弱；所有当前 RPKI 依赖方实现对恶意发布点攻击脆弱，折算为20.4%的 IPv4 地址空间；作者建议将发布点托管在保障高连通性的稳健平台上。这里的 validation 是路由验证，不能等同于用户登录认证。"},"limitations":{"evidence_ids":[],"status":"not_stated","text":""},"method":{"evidence_ids":["evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"status":"supported","text":"摘要报告构造并演示首批针对 RPKI 的降级攻击，利用连通性与安全性之间的权衡阻止从公共仓库检索 RPKI 对象，从而禁用 RPKI 验证；研究通过实验测量公共仓库与依赖方实现的脆弱性，并提出防御建议。"},"paper_id":"932b9f2a403b4a1433151236be9173f7"}],"research_gaps":[{"evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797","evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"statement":"推断性缺口（本综述由所给摘要范围推断，非作者声明的未来工作）：五篇摘要没有提供直接针对用户认证机制本身的设计或评估证据；WCD虽提到认证门后内容泄露，但其研究焦点是WCD检测与影响。该缺口只说明本证据集不足以回答认证机制层面的比较，不是断言这些论文或相关会议没有认证安全研究。"},{"evidence_ids":["evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"statement":"推断性缺口（本综述由所给摘要范围推断）：摘要报告了研究数量与高层结果，但没有展开观察时间窗口、样本招募/选择细节与代表性，例如WCD的Alexa Top 10K测量、LGBTQ+的14人访谈、内核的17个真实漏洞利用、ML的30篇论文审计和RPKI的公共仓库测量。不能据此断定研究未做这些工作，只能说明摘要未给出这些细节。"},{"evidence_ids":["evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"statement":"推断性缺口（本综述由所给摘要范围推断）：摘要报告的是实验、测量或访谈结果，但没有提供检测或防御措施在实际生产环境中的持续运行细节，如监测周期、覆盖范围、运行期误报/漏报。这不表示相关部署不存在；只是所给摘要没有展开这些部署细节，不能把实验或测量结果直接当作生产部署事实。"},{"evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797","evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"statement":"推断性缺口（本综述由所给摘要范围推断）：所给片段没有统一给出这五篇论文自身的会议与年份元数据；WCD片段提到的USENIX Security 2020是先前工作，不是本文元数据。因此仅凭这些摘要不能确认五篇均属于USENIX Security 2022认证安全专题，研究问题中的会议与年份范围仍缺少直接元数据支持。"}],"research_question":{"text":"比较 USENIX Security 2022 认证安全论文的研究方法、安全问题、主要发现与证据边界"},"schema_version":"research-report-content-v1","synthesis_findings":[{"evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797","evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"finding_id":"sf-1","paper_ids":["bf973b6a0943cb3d3165ec26e72e6915","240837c172070c94fb76db82dc400a9c","c74f345888764f1ac8def289ebee0ec4","29e0052a154dc45edd232d6dfa40c76c","932b9f2a403b4a1433151236be9173f7"],"statement":"在所选五篇摘要中，没有一篇把用户认证机制本身作为主要研究对象；WCD只相邻涉及认证门后内容的缓存泄露，其余四篇分别研究ML安全评估、LGBTQ+建议获取、内核利用可靠性和RPKI路由验证。该结论是摘要范围内的综述判断，不能外推为USENIX Security 2022全部认证论文的分布。"},{"evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797","evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"finding_id":"sf-2","paper_ids":["bf973b6a0943cb3d3165ec26e72e6915","240837c172070c94fb76db82dc400a9c","c74f345888764f1ac8def289ebee0ec4","29e0052a154dc45edd232d6dfa40c76c","932b9f2a403b4a1433151236be9173f7"],"statement":"所选摘要的方法组合覆盖文献审计、测量/实验、专家访谈、用户质性访谈与攻击构造；由于研究对象分别是ML安全评估、Web缓存、LGBTQ+安全建议、内核利用和RPKI，这些方法只能作为跨域方法类比，不能直接说明认证安全论文的方法偏好。"},{"evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797","evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"finding_id":"sf-3","paper_ids":["bf973b6a0943cb3d3165ec26e72e6915","240837c172070c94fb76db82dc400a9c","c74f345888764f1ac8def289ebee0ec4","29e0052a154dc45edd232d6dfa40c76c","932b9f2a403b4a1433151236be9173f7"],"statement":"证据边界上，五篇均只提供摘要级信息；摘要报告了实验、测量或访谈结果，但未提供统一的会议/年份元数据，也未展开观察窗口、样本代表性或部署运行细节。不能据此认定相关活动未发生，也不能把摘要结果升级为全文或部署结论。"},{"evidence_ids":["evidence-44519614fb9a207caa0862a203a7951dc728b187eb383ae3b5c0f0233ad9f797","evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-23f75d4d8234d2d3aeb8f5c114c8aa98f4f6dd25d4cc8faab1c13045e27cff56","evidence-0b0300e7cee17e17aab40e4f01220e54bb6abde3b66c9ef5e5c02db92ee69336","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"finding_id":"sf-4","paper_ids":["bf973b6a0943cb3d3165ec26e72e6915","240837c172070c94fb76db82dc400a9c","c74f345888764f1ac8def289ebee0ec4","29e0052a154dc45edd232d6dfa40c76c","932b9f2a403b4a1433151236be9173f7"],"statement":"跨域比较显示证据类型不同：WCD与RPKI提供测量数字，内核提供实验提升幅度，ML提供文献审计计数，LGBTQ+提供小规模质性访谈；这些差异应作为证据类型差异处理，而不是认证安全效果的排序。"},{"evidence_ids":["evidence-162114ae22e5563f7fa35c8102de6ec04334fc17057a9a64324b85295dd6f12c","evidence-073dbc05e4d47239cb1081582bd8973e44df4a5345541d074396b1551a43b09b"],"finding_id":"sf-5","paper_ids":["240837c172070c94fb76db82dc400a9c","932b9f2a403b4a1433151236be9173f7"],"statement":"WCD摘要中的“认证门后”是Web内容访问背景，RPKI摘要中的 validation 是路由起源验证；两者都不能被当作对用户登录认证机制的研究。把二者按关键词归为认证安全会混淆保护对象与系统层，故本报告将WCD标为相邻、RPKI标为跨域。"}]},"report_id":"f8ccfb15-0670-47fc-af6b-d78ed23ea626","report_url":"/api/research-tasks/387a5090b27550c59de86adb415eb26e/reports/1?format=json","report_version":1,"research_task_id":"387a5090b27550c59de86adb415eb26e","status":"completed","task_id":"387a5090b27550c59de86adb415eb26e"}