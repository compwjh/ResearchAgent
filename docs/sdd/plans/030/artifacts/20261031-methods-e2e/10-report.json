dfa40c76c","240837c172070c94fb76db82dc400a9c","bf973b6a0943cb3d3165ec26e72e6915","7d30bac1c3eb69f0e3dcbdf45ea5c261","506030dfdf859855c4ac72a6b64079cb"],"statement":"评估规模与评估对象不可直接比较：WCD研究在404个网站做对比实验并扩展到Alexa Top 10K；内核研究报告17个真实世界漏洞利用；ML安全评估论文研究过去10年30篇论文；NAS研究评估10种NAS方法；侧信道论文在ARM微控制器和若干代表性程序上评估攻击。摘要层面可以确认这些规模与对象，但未提供统一抽样框架或统计效力说明，因此不能据此对这些研究的代表性或证据强度作单一排序。"},{"dimension_id":"facet-2","evidence_ids":["evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902","evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5","evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f","evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134","evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3"],"paper_ids":["29e0052a154dc45edd232d6dfa40c76c","240837c172070c94fb76db82dc400a9c","bf973b6a0943cb3d3165ec26e72e6915","7d30bac1c3eb69f0e3dcbdf45ea5c261","506030dfdf859855c4ac72a6b64079cb"],"statement":"方法组合不同：内核论文使用专家访谈加漏洞利用实验并建立利用模型；WCD论文使用页面同一性检查与缓存头启发式并开展网站测量；ML安全评估论文使用30篇论文的文献研究加实证分析；NAS论文使用10种方法的实证比较并结合分析证据；侧信道论文使用恶意软件构造加ARM平台实验。摘要不足以支持统一的方法质量排序。"},{"dimension_id":"facet-1","evidence_ids":["evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5","evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902","evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134","evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3","evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f"],"paper_ids":["240837c172070c94fb76db82dc400a9c","29e0052a154dc45edd232d6dfa40c76c","7d30bac1c3eb69f0e3dcbdf45ea5c261","506030dfdf859855c4ac72a6b64079cb","bf973b6a0943cb3d3165ec26e72e6915"],"statement":"测量单位与结果形态不同：WCD报告漏洞或脆弱网站计数，内核论文报告可靠性百分比提升，侧信道论文报告跨检测器与硬件实现的攻击鲁棒性和可行性，NAS论文报告模型对多类攻击的脆弱性及架构属性，ML安全评估论文报告评估陷阱的普遍性与后果。摘要未给出统一指标定义、置信区间、方差或重复次数，因此跨研究效应大小不可直接换算。"},{"dimension_id":"facet-2","evidence_ids":["evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902","evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5","evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f"],"paper_ids":["29e0052a154dc45edd232d6dfa40c76c","240837c172070c94fb76db82dc400a9c","bf973b6a0943cb3d3165ec26e72e6915"],"statement":"证据生成方式不同：内核论文把人类专家意见作为起点并用实验检验专家观点；WCD论文以自动化检测启发式和互联网规模测量生成证据；ML安全评估论文以文献抽样研究与实证分析生成方法学证据。三者分别体现专家知识、自动化测量和元评估三种路径，摘要未说明这些路径在同一评估框架下如何互相校准。"}],"evidence_scope":{"paper_ids":["29e0052a154dc45edd232d6dfa40c76c","240837c172070c94fb76db82dc400a9c","bf973b6a0943cb3d3165ec26e72e6915","7d30bac1c3eb69f0e3dcbdf45ea5c261","506030dfdf859855c4ac72a6b64079cb"],"text":"仅使用5篇所选论文的摘要级摘录，共5条证据。摘要未一致标明USENIX Security 2022的会议或年份信息，因此本报告不声称全部论文均属于该会议/年份；结论限于摘要所述的实证评估方法、对象、测量单位与结果，不升级为全文核验，也不把摘要未说明的细节解释为相关活动不存在。"},"paper_analyses":[{"findings":{"evidence_ids":["evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902"],"status":"supported","text":"摘要报告的结果包括：许多受访内核安全专家对利用稳定化技术持有不正确观点；新技术使Linux内核利用可靠性平均提升14.87%；将新技术与现有稳定化方法组合后，平均提升135.53%，并比专业安全研究人员的稳定化结果高67.86%。关系：相邻——该研究是围绕Linux内核堆利用可靠性的实证评估实例，而不是对多篇论文评估方法本身的比较；认证机制不是摘要所述分析对象，分析与保护对象位于操作系统内核层的Linux内核堆内存及漏洞利用稳定性。"},"limitations":{"evidence_ids":[],"status":"not_stated","text":""},"method":{"evidence_ids":["evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902"],"status":"supported","text":"摘要报告：作者先访谈内核安全专家，收集实践中采用的利用稳定化技术及专家意见；随后在17个真实世界Linux内核堆漏洞利用上评估这些稳定化技术；再根据实验结果设计通用内核堆利用模型，用模型解释利用不可靠性并分析稳定化技术成功或失败的原因；最后提出一种新的稳定化技术，并实验评估其单独使用及与现有方法组合的效果。"},"paper_id":"29e0052a154dc45edd232d6dfa40c76c"},{"findings":{"evidence_ids":["evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5"],"status":"supported","text":"摘要报告：在404网站对比实验中，新方法识别超过100个漏洞，而既有“Cached and Confused”方法上限为18；在Alexa Top 10K上检测到1188个脆弱网站；案例研究表明WCD后果超出个人信息泄露，并且针对非认证页面的攻击也高度有害。关系：相邻——这是Web缓存欺骗检测与网站测量的实证评估实例，而非评估方法学比较；摘要以认证门后内容泄露为背景并扩展到非认证页面，保护/分析对象是Web应用与缓存层的网页及缓存内容，不能据此把研究等同于用户登录认证研究。"},"limitations":{"evidence_ids":[],"status":"not_stated","text":""},"method":{"evidence_ids":["evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5"],"status":"supported","text":"摘要报告：作者提出一种不依赖测试前提的Web Cache Deception检测方法，使用页面同一性检查与缓存头启发式来测试网站；在404个网站上开展对比实验，并在Alexa Top 10K上开展大规模WCD实验，同时用案例研究展示攻击后果。"},"paper_id":"240837c172070c94fb76db82dc400a9c"},{"findings":{"evidence_ids":["evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f"],"status":"supported","text":"摘要报告：对30篇论文的研究确认这些陷阱在当前安全文献中广泛存在；实证分析显示单个陷阱可造成不现实性能与解释，妨碍理解安全问题；作者提出规避或缓解建议，并列出开放问题。关系：直接——摘要直接讨论学习型安全系统的评估陷阱与方法学，回应“实证评估方法”问题；认证机制不是摘要所述分析对象，分析与保护对象是机器学习/安全评估层的学习型安全系统有效性与可靠性。"},"limitations":{"evidence_ids":[],"status":"not_stated","text":""},"method":{"evidence_ids":["evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f"],"status":"supported","text":"摘要报告：作者识别学习型安全系统在设计、实现和评估中的常见陷阱；对过去10年顶级安全会议的30篇论文开展研究；通过实证分析展示单个陷阱如何导致不现实的性能与解释；提出可操作建议，并指出机器学习应用于安全时的开放问题与研究方向。"},"paper_id":"bf973b6a0943cb3d3165ec26e72e6915"},{"findings":{"evidence_ids":["evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134"],"status":"supported","text":"摘要报告：相较手工设计模型，NAS生成模型更易受多种恶意操纵影响；作者给出的解释是，在巨大搜索空间与训练成本下，多数NAS方法偏好早期训练阶段快速收敛的模型，进而形成高损失平滑度、低梯度方差等与攻击脆弱性相关的架构属性；摘要还讨论增加单元深度、抑制跳跃连接等补救措施。关系：相邻——这是NAS模型安全性的实证评估实例，而非评估方法学比较；认证机制不是摘要所述分析对象，保护/分析对象是机器学习模型层的NAS生成模型完整性与安全性。"},"limitations":{"evidence_ids":[],"status":"not_stated","text":""},"method":{"evidence_ids":["evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134"],"status":"supported","text":"摘要报告：作者对10种流行神经架构搜索（NAS）方法开展广泛实证研究，比较NAS生成模型与手工设计模型在对抗逃逸、模型投毒、功能窃取等恶意操纵下的脆弱性，并结合实证与分析证据解释原因，最后讨论潜在补救措施。"},"paper_id":"7d30bac1c3eb69f0e3dcbdf45ea5c261"},{"findings":{"evidence_ids":["evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3"],"status":"supported","text":"摘要报告：实验显示该攻击在多种检测器模型和硬件实现上具有鲁棒性；在ARM微控制器与代表性程序上证明了可行性；作者据此强调需要进一步研究侧信道监控器。关系：相邻——这是嵌入式物理侧信道监控的攻击评估实例，而非评估方法学比较；认证机制不是摘要所述分析对象，保护/监控对象位于硬件/嵌入式层的微控制器程序执行与物理侧信道监控器。"},"limitations":{"evidence_ids":[],"status":"not_stated","text":""},"method":{"evidence_ids":["evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3"],"status":"supported","text":"摘要报告：作者提出一种针对物理侧信道监控系统的对抗攻击，制作功能性恶意软件，使其注入被侧信道监控的系统后不触发检测器；在ARM微控制器平台和若干代表性程序上评估，并跨检测器模型与硬件实现考察攻击鲁棒性。"},"paper_id":"506030dfdf859855c4ac72a6b64079cb"}],"research_gaps":[{"evidence_ids":["evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5","evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902","evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3","evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f"],"statement":"推断性缺口（基于摘要信息粒度）：除ML安全评估论文明确以过去10年顶级安全会议的30篇论文为范围外，WCD、内核和侧信道摘要未说明数据采集或实验观察窗口与时间粒度。该细节缺失限制跨研究的时间可比性；这不表示相关测量或实验没有发生。"},{"evidence_ids":["evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5","evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902","evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3","evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134"],"statement":"推断性缺口：摘要未说明若干样本的选取与代表性细节，例如404个网站与Alexa Top 10K如何抽样、17个真实漏洞利用如何选取、ARM平台上的代表性程序如何选取、10种NAS方法如何选取。缺少这些细节使跨研究外推需谨慎；这是对摘要信息粒度的推断，而非否认研究进行了样本选择。"},{"evidence_ids":["evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5","evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f","evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134","evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902","evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3"],"statement":"推断性缺口：各摘要报告了不同形态的结果，但未提供统一指标定义或统计不确定性报告（如置信区间、方差、重复次数）。因此本综述不能把百分比提升、漏洞计数、鲁棒性描述和架构属性直接换算为同一效应尺度；这是对摘要报告粒度的推断。"},{"evidence_ids":["evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3","evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f","evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134"],"statement":"作者陈述的未来工作或开放问题：侧信道论文强调需进一步研究侧信道监控器；ML安全评估论文指出开放问题并提供研究方向；NAS论文讨论补救措施并给出若干研究方向。这些是作者陈述，不等同于本综述推断的缺口，也不应被改写成摘要未报告相应结果。"}],"research_question":{"text":"比较 USENIX Security 2022 论文中的实证评估方法。"},"schema_version":"research-report-content-v1","synthesis_findings":[{"evidence_ids":["evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902","evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5","evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f","evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134","evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3"],"finding_id":"finding-1","paper_ids":["29e0052a154dc45edd232d6dfa40c76c","240837c172070c94fb76db82dc400a9c","bf973b6a0943cb3d3165ec26e72e6915","7d30bac1c3eb69f0e3dcbdf45ea5c261","506030dfdf859855c4ac72a6b64079cb"],"statement":"五个摘要呈现的实证评估设计具有明显多样性：网站对比实验与大规模测量、专家访谈加漏洞利用实验、30篇论文的文献研究加实证分析、10种NAS方法的实证研究、ARM平台上的攻击实验。基于这些摘要，不能把“实证评估方法”概括为单一模板；可比较的是各自报告的对象、规模、测量单位和证据生成方式，而不是用一个统一分数排序。"},{"evidence_ids":["evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5","evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902","evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3","evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134","evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f"],"finding_id":"finding-2","paper_ids":["29e0052a154dc45edd232d6dfa40c76c","240837c172070c94fb76db82dc400a9c","bf973b6a0943cb3d3165ec26e72e6915","7d30bac1c3eb69f0e3dcbdf45ea5c261","506030dfdf859855c4ac72a6b64079cb"],"statement":"按评估对象和测量单位，至少可区分五类证据：漏洞或脆弱网站计数、漏洞利用可靠性百分比提升、攻击在检测器与硬件上的鲁棒性和可行性、模型对多种攻击的脆弱性及架构属性、评估陷阱在文献中的普遍性及后果。摘要未提供统一的可比尺度，因此跨论文比较应停留在维度对照，而不应把不同单位的结果直接合并。"},{"evidence_ids":["evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f","evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134","evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902"],"finding_id":"finding-3","paper_ids":["bf973b6a0943cb3d3165ec26e72e6915","7d30bac1c3eb69f0e3dcbdf45ea5c261","29e0052a154dc45edd232d6dfa40c76c"],"statement":"直接讨论评估陷阱的ML安全论文梳理30篇顶级安全会议论文，确认陷阱广泛存在，并用实证分析说明单个陷阱可导致不现实性能与解释；NAS实证研究作为相邻实例显示模型安全评估需同时考虑攻击类型与架构属性；内核论文中专家意见与实验结果不一致的相邻证据也提示，评估假设本身可能需要检验。这些证据支持“评估设计与评估对象会影响结论有效性”，但摘要不足以形成跨领域统一评估框架。"},{"evidence_ids":["evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902","evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5","evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f","evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134","evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3"],"finding_id":"finding-4","paper_ids":["29e0052a154dc45edd232d6dfa40c76c","240837c172070c94fb76db82dc400a9c","bf973b6a0943cb3d3165ec26e72e6915","7d30bac1c3eb69f0e3dcbdf45ea5c261","506030dfdf859855c4ac72a6b64079cb"],"statement":"认证不是这些摘要的共同分析对象：仅WCD摘要明确以认证门后内容泄露为背景，并进一步讨论非认证页面；其他摘要分别讨论内核堆利用、ML评估陷阱、NAS模型脆弱性和侧信道监控。因此不能把认证或用户登录作为统一比较轴；若要比较认证相关评估，需要额外证据。"},{"evidence_ids":["evidence-a3f09719df18a191bc77e87837839c7bf09fea47274054317da1ec71752b2902","evidence-0f150b18863b9a2e845b4a90d491f14d8f34579197f0a4ea6af65fe9361bc7f5","evidence-61d97a5a835dbda58d9796823100fd242ad835b0d7f01828c009e128a460494f","evidence-8e875061c70b906fd85125969f442d2a453112bf2be6c28545a239c7b4270134","evidence-c27a4aa0f076f3e4a49b69cc20e4d42b3dbc291e5ccb277076b8f22b76c27fd3"],"finding_id":"finding-5","paper_ids":["29e0052a154dc45edd232d6dfa40c76c","240837c172070c94fb76db82dc400a9c","bf973b6a0943cb3d3165ec26e72e6915","7d30bac1c3eb69f0e3dcbdf45ea5c261","506030dfdf859855c4ac72a6b64079cb"],"statement":"规模与深度并非同一维度：WCD扩展到Alexa Top 10K，内核论文聚焦17个真实漏洞利用的可靠性，侧信道论文聚焦ARM平台上的代表性程序，NAS论文聚焦10种方法，ML安全评估论文聚焦30篇论文。摘要未说明这些样本规模如何与结论外推范围对应，因此不能仅凭样本数量判断证据强弱。"}]},"report_id":"4b7212ea-7f22-40ae-bf32-1b788f9a466b","report_url":"/api/research-tasks/f19f879e4b05587ba0246768fa15cf46/reports/1?format=json","report_version":1,"research_task_id":"f19f879e4b05587ba0246768fa15cf46","status":"completed","task_id":"f19f879e4b05587ba0246768fa15cf46"}