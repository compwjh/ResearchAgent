.env
__pycache__/
*.py[cod]
.venv/
frontend/.DS_Store
.DS_Store
.idea/
*.log
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.pytest-basetemp/
# pytest --basetemp 残留目录（子代理跑定向测试时生成，含临时 sqlite，勿入库）
.pytest-tmp-*
**/.pytest-tmp-*
# WorkBuddy 项目运行数据（进度日志、会话记忆等），非源码资产
.workbuddy-ai/
.ruff_cache/
# .codebuddy 下 agents/skills/models.json 属项目资产，需入库共享；
# 仅忽略 IDE 运行数据（plans/本地设置/记忆）
.codebuddy/plans/
.codebuddy/settings.local.json
.codebuddy/agent-memory/
.codebuddy/agent-logs/
data/articles/
data/browser-profile/
data/paper_search/
**/.profile.lock
data/article_settings.json
data/kb/
data/models/
data/agent_tasks.sqlite3
# spec-038 L1 文件记忆：真实记忆文件属用户隐私，绝不入库。
# 仓库只提交仓库根目录的 USER.example.md / MEMORY.example.md 模板（同 .env 模式）。
data/memory/
data/memory/*.md
data/memory/projects/
deploy/reranker/.runtime/
deploy/run.pid

# Spec018 rebuild staging/runtime artifacts (large manifests; canonical live
# manifests and generation marker remain under ignored data/kb/).
.sdd/runtime/

# Langfuse vendor runtime/dependency artefacts; source code remains tracked.
vendor/langfuse/.env
vendor/langfuse/node_modules/
vendor/langfuse/**/node_modules/
vendor/langfuse/**/.next/
vendor/langfuse/**/coverage/
vendor/langfuse/**/dist/
.pnpm-store/
